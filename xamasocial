<script>
  // =========================================================
  // Starfield canvas (unchanged visuals, same star behavior)
  // =========================================================
  const canvas = document.getElementById('stars');
  const ctx = canvas.getContext('2d');
  let stars = [];
  let w, h;
  let dpr = Math.min(window.devicePixelRatio || 1, 1.5);

  function resize(){
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.floor((w * h) / 4200);
    stars = Array.from({length: count}, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: Math.random() * 1.3 + 0.2,
      speed: Math.random() * 0.15 + 0.02,
      tw: Math.random() * Math.PI * 2,
      hue: Math.random() > 0.85 ? '79,246,255' : '255,255,255'
    }));
  }

  function draw(){
    ctx.clearRect(0, 0, w, h);
    for(const s of stars){
      s.tw += 0.02;
      const alpha = 0.5 + Math.sin(s.tw) * 0.5;
      ctx.beginPath();
      ctx.fillStyle = `rgba(${s.hue}, ${alpha.toFixed(2)})`;
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
      s.y += s.speed;
      if(s.y > h){ s.y = 0; s.x = Math.random() * w; }
    }
    requestAnimationFrame(draw);
  }

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(resize, 150);
  });
  resize();
  draw();

  // =========================================================
  // Smooth cursor parallax (rAF-batched, GPU-only transforms)
  // =========================================================
  const starsEl = document.getElementById('stars');
  const gridEl = document.querySelector('.grid-floor');
  const heroEl = document.getElementById('hero-3d');

  let targetPX = 0, targetPY = 0;
  let curPX = 0, curPY = 0;
  let rafQueued = false;

  window.addEventListener('mousemove', (e) => {
    targetPX = (e.clientX / window.innerWidth) - 0.5;
    targetPY = (e.clientY / window.innerHeight) - 0.5;
    if(!rafQueued){
      rafQueued = true;
      requestAnimationFrame(updateParallax);
    }
  }, { passive: true });

  function updateParallax(){
    // ease toward target for a smooth, non-janky feel
    curPX += (targetPX - curPX) * 0.12;
    curPY += (targetPY - curPY) * 0.12;

    starsEl.style.transform = `translate3d(${(curPX * -40).toFixed(2)}px, ${(curPY * -40).toFixed(2)}px, 0) scale(1.05)`;
    gridEl.style.transform = `perspective(400px) rotateX(${(70 - curPY * 10).toFixed(2)}deg) rotateZ(${(curPX * 4).toFixed(2)}deg) scale(2) translate3d(${(curPX * 30).toFixed(2)}px, 0, 0)`;
    heroEl.style.transform = `rotateX(${(curPY * -14).toFixed(2)}deg) rotateY(${(curPX * 18).toFixed(2)}deg) translateZ(20px)`;

    if(Math.abs(targetPX - curPX) > 0.001 || Math.abs(targetPY - curPY) > 0.001){
      requestAnimationFrame(updateParallax);
    } else {
      rafQueued = false;
    }
  }

  // =========================================================
  // Card tilt — cache rect on enter, rAF-batched on move
  // =========================================================
  document.querySelectorAll('.card').forEach(card => {
    let rect = null;
    let cardRaf = false;
    let mx = 0, my = 0;

    card.addEventListener('mouseenter', () => {
      rect = card.getBoundingClientRect();
    });

    card.addEventListener('mousemove', (e) => {
      mx = e.clientX; my = e.clientY;
      if(!rect) rect = card.getBoundingClientRect();
      if(!cardRaf){
        cardRaf = true;
        requestAnimationFrame(() => {
          const x = mx - rect.left;
          const y = my - rect.top;
          const rotateX = ((y / rect.height) - 0.5) * -10;
          const rotateY = ((x / rect.width) - 0.5) * 10;
          card.style.transform = `translate3d(0,-6px,0) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale(1.02)`;
          cardRaf = false;
        });
      }
    }, { passive: true });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'translate3d(0,0,0)';
      rect = null;
    });
  });

  // =========================================================
  // Link confirmation modal (opens in same tab, no new tab)
  // =========================================================
  const overlay = document.getElementById('confirm-overlay');
  const destEl = document.getElementById('confirm-dest');
  const yesBtn = document.getElementById('confirm-yes');
  const noBtn = document.getElementById('confirm-no');
  let pendingHref = null;

  document.querySelectorAll('a[data-confirm="true"]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      pendingHref = link.getAttribute('href');
      destEl.textContent = link.getAttribute('data-service') || 'this link';
      overlay.classList.add('open');
    });
  });

  yesBtn.addEventListener('click', () => {
    if(pendingHref){ window.location.href = pendingHref; }
    overlay.classList.remove('open');
  });
  noBtn.addEventListener('click', () => {
    pendingHref = null;
    overlay.classList.remove('open');
  });
  overlay.addEventListener('click', (e) => {
    if(e.target === overlay){ overlay.classList.remove('open'); pendingHref = null; }
  });

  // =========================================================
  // Language switcher
  // =========================================================
  const translations = {
    en: {
      "confirm-text-pre": "Are you sure you want to visit this link:",
      "confirm-yes": "Yes, take me there",
      "confirm-no": "Cancel",
      "eyebrow": "Live Signal",
      "section-connect": "Connect",
      "section-videos": "Featured Videos",
      "label-youtube": "YouTube",
      "label-freefire": "Free Fire UID",
      "label-instagram": "Instagram",
      "label-discord": "Discord",
      "video-caption": "Latest Upload",
      "footer": "Transmission stable // est. 2026"
    },
    zh: {
      "confirm-text-pre": "您確定要前往這個連結嗎：",
      "confirm-yes": "是的，帶我去",
      "confirm-no": "取消",
      "eyebrow": "即時訊號",
      "section-connect": "連結",
      "section-videos": "精選影片",
      "label-youtube": "YouTube",
      "label-freefire": "Free Fire 遊戲ID",
      "label-instagram": "Instagram",
      "label-discord": "Discord",
      "video-caption": "最新上傳",
      "footer": "訊號穩定 // 2026年建立"
    },
    ar: {
      "confirm-text-pre": "هل أنت متأكد أنك تريد زيارة هذا الرابط:",
      "confirm-yes": "نعم، خذني إلى هناك",
      "confirm-no": "إلغاء",
      "eyebrow": "إشارة مباشرة",
      "section-connect": "تواصل",
      "section-videos": "فيديوهات مميزة",
      "label-youtube": "يوتيوب",
      "label-freefire": "معرف فري فاير",
      "label-instagram": "إنستغرام",
      "label-discord": "ديسكورد",
      "video-caption": "أحدث رفع",
      "footer": "الإشارة مستقرة // تأسست 2026"
    },
    es: {
      "confirm-text-pre": "¿Seguro que quieres visitar este enlace:",
      "confirm-yes": "Sí, llévame",
      "confirm-no": "Cancelar",
      "eyebrow": "Señal en vivo",
      "section-connect": "Conectar",
      "section-videos": "Videos destacados",
      "label-youtube": "YouTube",
      "label-freefire": "UID de Free Fire",
      "label-instagram": "Instagram",
      "label-discord": "Discord",
      "video-caption": "Última subida",
      "footer": "Transmisión estable // est. 2026"
    }
  };

  const settingsBtn = document.getElementById('settings-btn');
  const langMenu = document.getElementById('lang-menu');
  const confirmTextP = document.querySelector('[data-i18n="confirm-text"]');

  settingsBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    langMenu.classList.toggle('open');
  });
  document.addEventListener('click', (e) => {
    if(!langMenu.contains(e.target) && e.target !== settingsBtn){
      langMenu.classList.remove('open');
    }
  });

  function applyLanguage(lang){
    const dict = translations[lang] || translations.en;

    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if(key === 'confirm-text') return; // handled separately below
      if(dict[key] !== undefined){ el.textContent = dict[key]; }
    });

    // rebuild the confirm sentence, keeping the live destination span intact
    confirmTextP.innerHTML = dict['confirm-text-pre'] + ' <span class="dest" id="confirm-dest">' + (destEl ? destEl.textContent : 'youtube') + '</span>?';

    document.body.dir = (lang === 'ar') ? 'rtl' : 'ltr';
    document.body.classList.remove('lang-ar', 'lang-zh');
    if(lang === 'ar') document.body.classList.add('lang-ar');
    if(lang === 'zh') document.body.classList.add('lang-zh');

    document.querySelectorAll('.lang-option').forEach(opt => {
      opt.classList.toggle('active', opt.getAttribute('data-lang') === lang);
    });

    localStorage.setItem('xama-lang', lang);
  }

  document.querySelectorAll('.lang-option').forEach(opt => {
    opt.addEventListener('click', () => {
      applyLanguage(opt.getAttribute('data-lang'));
      langMenu.classList.remove('open');
    });
  });

  // restore saved language on load (defaults to English)
  applyLanguage(localStorage.getItem('xama-lang') || 'en');
</script>

