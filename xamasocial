<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>XAMA // Command Deck</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;600;700&family=Noto+Sans+SC:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --void: #050914;
    --void-2: #0a1224;
    --panel: rgba(12, 22, 45, 0.55);
    --panel-border: rgba(90, 220, 255, 0.25);
    --cyan: #4ff6ff;
    --cyan-bright: #b6fbff;
    --blue: #2f6bff;
    --blue-deep: #0a2a6b;
    --text: #d8f2ff;
    --text-dim: #7fa3c2;
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }

  body{
    margin:0;
    min-height:100vh;
    background:
      radial-gradient(ellipse 80% 60% at 50% -10%, rgba(47,107,255,0.25), transparent 60%),
      radial-gradient(ellipse 60% 50% at 85% 20%, rgba(79,246,255,0.10), transparent 60%),
      linear-gradient(180deg, var(--void) 0%, var(--void-2) 100%);
    color: var(--text);
    font-family: 'Rajdhani', sans-serif;
    overflow-x:hidden;
    position:relative;
  }

  body[dir="rtl"] .section-label{ flex-direction: row-reverse; }
  body[dir="rtl"] .section-label::after{ background: linear-gradient(270deg, rgba(79,246,255,0.6), transparent); }
  body[dir="rtl"] .card{ text-align: right; }

  body.lang-ar, body.lang-zh{ font-family: 'Noto Sans Arabic', 'Noto Sans SC', 'Rajdhani', sans-serif; }

  /* ---------- Starfield ---------- */
  #stars{
    position:fixed; inset:-5%; width:110%; height:110%; z-index:0; pointer-events:none;
    transform: translate3d(0,0,0);
    will-change: transform;
  }

  /* ---------- Scanline / grid floor ---------- */
  .grid-floor{
    position:fixed;
    left:0; right:0; bottom:0;
    height:45vh;
    background-image:
      linear-gradient(rgba(79,246,255,0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(79,246,255,0.18) 1px, transparent 1px);
    background-size: 48px 48px;
    transform: perspective(400px) rotateX(70deg) scale(2) translate3d(0,0,0);
    transform-origin: bottom;
    mask-image: linear-gradient(to top, black 10%, transparent 90%);
    -webkit-mask-image: linear-gradient(to top, black 10%, transparent 90%);
    opacity:0.35;
    z-index:0;
    pointer-events:none;
    will-change: transform;
  }

  main{ position:relative; z-index:1; max-width:920px; margin:0 auto; padding: 64px 24px 120px; }

  #scene{ perspective: 1200px; }

  #hero-3d{
    will-change: transform;
    transform-style: preserve-3d;
    transform: translate3d(0,0,0);
  }

  /* ---------- Settings / language switcher ---------- */
  #settings-btn{
    position: fixed;
    top: 18px;
    right: 18px;
    z-index: 50;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    backdrop-filter: blur(8px);
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  #settings-btn:hover{ border-color: rgba(79,246,255,0.8); transform: rotate(35deg); }
  #settings-btn svg{ width:22px; height:22px; stroke: var(--cyan-bright); fill:none; stroke-width:1.8; }

  body[dir="rtl"] #settings-btn{ right:auto; left:18px; }

  #lang-menu{
    position: fixed;
    top: 68px;
    right: 18px;
    z-index: 50;
    background: rgba(8,16,34,0.92);
    border: 1px solid var(--panel-border);
    border-radius: 12px;
    backdrop-filter: blur(10px);
    padding: 8px;
    min-width: 170px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.5), 0 0 20px rgba(79,246,255,0.12);
    opacity: 0;
    transform: translateY(-8px) scale(0.96);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  #lang-menu.open{ opacity:1; transform: translateY(0) scale(1); pointer-events:auto; }
  body[dir="rtl"] #lang-menu{ right:auto; left:18px; }

  .lang-option{
    display:flex;
    align-items:center;
    gap:10px;
    padding: 10px 12px;
    border-radius: 8px;
    font-family:'Rajdhani', sans-serif;
    font-size: 15px;
    letter-spacing: 0.5px;
    color: var(--text);
    cursor:pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lang-option:hover{ background: rgba(79,246,255,0.12); color: var(--cyan-bright); }
  .lang-option.active{ color: var(--cyan); }
  .lang-option .flag{ font-size:18px; }

  /* ---------- Confirm modal ---------- */
  #confirm-overlay{
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(3,6,14,0.7);
    backdrop-filter: blur(4px);
    display:flex;
    align-items:center;
    justify-content:center;
    opacity:0;
    pointer-events:none;
    transition: opacity 0.2s ease;
  }
  #confirm-overlay.open{ opacity:1; pointer-events:auto; }

  #confirm-box{
    background: linear-gradient(160deg, rgba(15,28,55,0.95), rgba(6,12,26,0.95));
    border: 1px solid rgba(79,246,255,0.4);
    border-radius: 16px;
    padding: 28px 26px;
    max-width: 340px;
    width: 88%;
    text-align:center;
    box-shadow: 0 25px 60px rgba(0,0,0,0.6), 0 0 40px rgba(79,246,255,0.2);
    transform: scale(0.92) translateY(10px);
    transition: transform 0.2s ease;
  }
  #confirm-overlay.open #confirm-box{ transform: scale(1) translateY(0); }

  #confirm-box p{
    font-size: 16px;
    line-height:1.5;
    margin: 0 0 22px;
    color: var(--text);
  }
  #confirm-box .dest{
    color: var(--cyan-bright);
    font-weight:700;
    text-transform: capitalize;
  }

  .confirm-actions{ display:flex; gap:12px; justify-content:center; }
  .confirm-actions button{
    font-family:'Orbitron', sans-serif;
    font-size:11px;
    letter-spacing:2px;
    text-transform:uppercase;
    padding: 11px 18px;
    border-radius: 8px;
    border: 1px solid var(--panel-border);
    background: rgba(79,246,255,0.06);
    color: var(--text);
    cursor:pointer;
    transition: all 0.2s ease;
  }
  #confirm-yes{ border-color: rgba(79,246,255,0.6); color: var(--cyan-bright); }
  #confirm-yes:hover{ background: rgba(79,246,255,0.2); box-shadow: 0 0 18px rgba(79,246,255,0.35); }
  #confirm-no:hover{ background: rgba(255,255,255,0.06); }

  /* ---------- Hero / 3D Title ---------- */
  .hero{
    text-align:center;
    padding: 40px 0 56px;
  }

  .eyebrow{
    font-family:'Orbitron', sans-serif;
    font-size:12px;
    letter-spacing:6px;
    color: var(--cyan);
    opacity:0.75;
    margin-bottom:18px;
    text-transform:uppercase;
  }

  .eyebrow::before, .eyebrow::after{
    content:'—';
    margin: 0 10px;
    opacity:0.5;
  }

  .title-3d{
    font-family:'Orbitron', sans-serif;
    font-weight:900;
    font-size: clamp(56px, 14vw, 140px);
    line-height:1;
    letter-spacing: 6px;
    margin:0;
    color: #eafeff;
    display:inline-block;
    transform-style: preserve-3d;
    perspective: 600px;
    -webkit-text-stroke: 1px rgba(255,255,255,0.4);
    text-shadow:
      0 1px 0 #d8fdff,
      0 2px 0 #bdf9ff,
      0 3px 0 #a2f2ff,
      0 4px 0 #87e9ff,
      0 5px 0 #6ddcff,
      0 6px 0 #53c9fa,
      0 7px 0 #3bb0ef,
      0 8px 0 #2f95d8,
      0 9px 0 #2679bd,
      0 10px 0 #1c5f9e,
      0 11px 0 #144a80,
      0 12px 18px rgba(0,0,0,0.7),
      0 0 12px rgba(255,255,255,0.5),
      0 0 35px rgba(79,246,255,0.85),
      0 0 75px rgba(47,107,255,0.6),
      0 0 130px rgba(47,107,255,0.35);
    animation: floatTitle 6s ease-in-out infinite;
  }

  @keyframes floatTitle{
    0%, 100%{ transform: rotateX(16deg) rotateY(-4deg) translateY(0px); }
    50%{ transform: rotateX(10deg) rotateY(4deg) translateY(-10px); }
  }

  .subtitle{
    margin-top: 22px;
    font-family:'Rajdhani', sans-serif;
    font-size: 17px;
    letter-spacing: 2px;
    color: var(--text-dim);
    text-transform:uppercase;
  }

  .subtitle span{ color: var(--cyan); }

  /* ---------- Section labels ---------- */
  .section-label{
    font-family:'Orbitron', sans-serif;
    font-size:13px;
    letter-spacing:4px;
    text-transform:uppercase;
    color: var(--cyan);
    margin: 56px 0 20px;
    display:flex;
    align-items:center;
    gap:14px;
  }
  .section-label::after{
    content:'';
    flex:1;
    height:1px;
    background: linear-gradient(90deg, rgba(79,246,255,0.6), transparent);
  }

  /* ---------- Link Cards ---------- */
  .link-grid{
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    perspective: 1000px;
  }

  .card{
    position:relative;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 14px;
    padding: 22px 22px;
    backdrop-filter: blur(10px);
    display:flex;
    align-items:center;
    gap:16px;
    text-decoration:none;
    color: var(--text);
    transition: border-color 0.35s ease, box-shadow 0.35s ease;
    transform-style: preserve-3d;
    overflow:hidden;
    will-change: transform;
    transform: translate3d(0,0,0);
  }

  .card::before{
    content:'';
    position:absolute; inset:0;
    background: linear-gradient(135deg, rgba(79,246,255,0.10), transparent 60%);
    opacity:0;
    transition: opacity 0.35s ease;
  }

  .card:hover{
    border-color: rgba(79,246,255,0.7);
    box-shadow: 0 18px 40px rgba(0,0,0,0.45), 0 0 30px rgba(79,246,255,0.25);
  }
  .card:hover::before{ opacity:1; }

  .card .icon{
    width:46px; height:46px;
    flex-shrink:0;
    border-radius:10px;
    display:flex; align-items:center; justify-content:center;
    background: linear-gradient(145deg, var(--blue-deep), #051333);
    border: 1px solid rgba(79,246,255,0.35);
    box-shadow: inset 0 0 12px rgba(79,246,255,0.25);
  }
  .card .icon svg{ width:24px; height:24px; fill:none; stroke:var(--cyan-bright); stroke-width:1.8; }

  .card .label{
    font-family:'Orbitron', sans-serif;
    font-size:12px;
    letter-spacing:2px;
    color: var(--text-dim);
    text-transform:uppercase;
    margin-bottom:4px;
  }
  .card .value{
    font-size:19px;
    font-weight:600;
    color: var(--cyan-bright);
    letter-spacing:0.5px;
  }

  /* ---------- Video Grid ---------- */
  .video-grid{
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
  }

  .video-box{
    position:relative;
    border-radius: 14px;
    padding: 10px;
    background: linear-gradient(160deg, rgba(20,40,80,0.6), rgba(5,10,25,0.6));
    border: 1px solid var(--panel-border);
    box-shadow: 0 0 0 1px rgba(0,0,0,0.2), 0 20px 40px rgba(0,0,0,0.4);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .video-box:hover{
    transform: translateY(-4px);
    box-shadow: 0 25px 50px rgba(0,0,0,0.5), 0 0 30px rgba(79,246,255,0.2);
  }

  .video-box .frame-wrap{
    position:relative;
    width:100%;
    padding-top:56.25%; /* 16:9 */
    border-radius: 9px;
    overflow:hidden;
    background:#000;
    border: 1px solid rgba(79,246,255,0.3);
  }
  .video-box iframe{
    position:absolute; inset:0;
    width:100%; height:100%;
    border:0;
  }

  .video-caption{
    font-family:'Rajdhani', sans-serif;
    font-size:14px;
    letter-spacing:1px;
    color: var(--text-dim);
    padding: 12px 6px 4px;
  }

  /* ---------- Footer ---------- */
  footer{
    text-align:center;
    margin-top: 70px;
    font-family:'Orbitron', sans-serif;
    font-size:11px;
    letter-spacing:3px;
    color: var(--text-dim);
    opacity:0.6;
    text-transform:uppercase;
  }

  @media (max-width: 480px){
    .title-3d{ letter-spacing:2px; }
    main{ padding: 40px 16px 90px; }
  }

  @media (prefers-reduced-motion: reduce){
    .title-3d{ animation: none; }
    * { transition-duration: 0.01ms !important; }
  }
</style>
